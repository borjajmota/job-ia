# --- LLM (nivel L4). Gemini como via principal, Groq (tier gratuito) como
# respaldo si Gemini falla del todo.
GEMINI_API_KEY=
JOBIA_LLM_MODEL=gemini-3.6-flash
GROQ_API_KEY=

# --- Email (Gmail con app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# --- Operacion
JOBIA_DB_PATH=data/jobia.db
JOBIA_CACHE_DIR=data/cache
JOBIA_DRY_RUN=0          # 1 = no envia email, imprime por consola
JOBIA_REPLAY=0           # 1 = usa cache en disco, NO toca LinkedIn
