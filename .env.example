# --- LLM (nivel L4). Tier gratuito de Groq.
GROQ_API_KEY=
JOBIA_LLM_MODEL=llama-3.3-70b-versatile

# --- Email (Gmail con app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# --- Operacion
JOBIA_DB_PATH=data/jobia.db
JOBIA_CACHE_DIR=data/cache
JOBIA_DRY_RUN=0          # 1 = no envia email, imprime por consola
JOBIA_REPLAY=0           # 1 = usa cache en disco, NO toca LinkedIn
